# ===== קופת לזכרו · במקום פרחים =====
# מעתיקים ל-.env.local לפיתוח מקומי. בפרודקשן המפתחות מודבקים ב-Vercel בלבד.

# מסד הנתונים (Neon דרך Vercel Storage מגדיר DATABASE_URL אוטומטית)
DATABASE_URL=
# לפיתוח בלי מסד: KUPA_LOCAL_DB=memory מריץ Postgres בזיכרון (pglite). לא לפרודקשן.
# KUPA_LOCAL_DB=memory

# מורנינג (Green Invoice) — מפתח API מהגדרות ← חיבורים ← API
MORNING_ID=
MORNING_SECRET=
# אסימון אקראי להודעה-חזרה (notifyUrl). למשל: openssl rand -hex 24
MORNING_HOOK=
# אופציונלי: מזהה מסוף הסליקה. אם ריק, נשלף פעם אחת מ-/plugins ונשמר בטבלת settings.
MORNING_PLUGIN_ID=

# סיסמת מסך הניהול /admin
ADMIN_PASSWORD=

# כתובת האתר (ל-successUrl/notifyUrl ולקישורי שיתוף). בלי / בסוף.
NEXT_PUBLIC_SITE_URL=https://kupa.avlut.org.il
# שם המותג (ברירת מחדל: לזכרם)
NEXT_PUBLIC_BRAND=לזכרם
# המותג בצד המשפחה והספק, אם שונה (למשל: אבלות ישראל). ברירת מחדל: NEXT_PUBLIC_BRAND
NEXT_PUBLIC_FAMILY_BRAND=
# האתר הראשי שאליו מוביל הלוגו בצד המשפחה (ברירת מחדל: /)
NEXT_PUBLIC_HOME_URL=
# תוספת תפעול באחוזים, נוספת לכל הפקדה (ההכנסה של השירות)
FEE_PCT=6
# required = על כל הפקדה (ברירת מחדל). optional = המפקיד יכול לבטל
FEE_MODE=required
# טלפון ליצירת קשר בתחתית העמודים (אופציונלי)
NEXT_PUBLIC_CONTACT_PHONE=
