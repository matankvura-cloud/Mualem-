{
  "name": "matana-shel-nechama",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --import tsx db/migrate.ts",
    "db:seed": "node --import tsx db/migrate.ts --seed",
    "db:reset": "psql \"$DATABASE_ADMIN_URL_ROOT\" -c \"drop database if exists matana\" -c \"create database matana\" && npm run db:seed",
    "test:db": "node --import tsx --test db/tests/*.test.ts",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.17",
    "next": "15.5.29",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
